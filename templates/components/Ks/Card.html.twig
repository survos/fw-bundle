{#
    Anonymous component: <twig:SurvosFw:Ks:Card title="..." footer="...">content</twig:SurvosFw:Ks:Card>
#}
{% props title = null, footer = null, outline = false, raised = false %}
<div class="card{{ outline ? ' card-outline' : '' }}{{ raised ? ' card-raised' : '' }}">
    {% if title %}<div class="card-header">{{ title }}</div>{% endif %}
    <div class="card-content card-content-padding">
        {% block content %}{% endblock %}
    </div>
    {% if footer %}<div class="card-footer">{{ footer }}</div>{% endif %}
</div>
