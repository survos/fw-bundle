{#
    Anonymous component: <twig:SurvosFw:Ks:Button variant="fill" round="true" href="#">Label</twig:SurvosFw:Ks:Button>
    variant: plain|fill|outline|tonal
#}
{% props variant = 'plain', round = false, raised = false, large = false, small = false, active = false, color = null, href = null %}
{% set classes = ['button'] %}
{% if variant == 'fill' %}{% set classes = classes|merge(['button-fill']) %}{% endif %}
{% if variant == 'outline' %}{% set classes = classes|merge(['button-outline']) %}{% endif %}
{% if variant == 'tonal' %}{% set classes = classes|merge(['button-tonal']) %}{% endif %}
{% if round %}{% set classes = classes|merge(['button-round']) %}{% endif %}
{% if raised %}{% set classes = classes|merge(['button-raised']) %}{% endif %}
{% if large %}{% set classes = classes|merge(['button-large']) %}{% endif %}
{% if small %}{% set classes = classes|merge(['button-small']) %}{% endif %}
{% if active %}{% set classes = classes|merge(['button-active']) %}{% endif %}
{% if color %}{% set classes = classes|merge(['color-' ~ color]) %}{% endif %}
{% set tag = href ? 'a' : 'button' %}
<{{ tag }}{% if href %} href="{{ href }}"{% endif %} class="{{ classes|join(' ') }}">{% block content %}{% endblock %}</{{ tag }}>
